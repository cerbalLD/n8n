		{
			"name": "Local content backend (Python)",
			"type": "debugpy",
			"request": "launch",
			"module": "uvicorn",
			"args": [
				"app.main:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"cwd": "${workspaceFolder}/backend",
			"console": "integratedTerminal",
			"justMyCode": false
		},
		{
			"name": "Local n8n app (Node)",
			"type": "node",
			"request": "launch",
			"runtimeExecutable": "corepack",
			"runtimeArgs": ["pnpm", "start"],
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"],
			"env": {
				"N8N_DEFAULT_LOCALE": "ru",
				"N8N_LOCAL_LICENSE_BYPASS": "true",
				"N8N_SECURE_COOKIE": "false",
				"N8N_TEMPLATES_ENABLED": "true",
				"N8N_TEMPLATES_HOST": "http://127.0.0.1:8000/api/",
				"N8N_LICENSE_SERVER_URL": "http://127.0.0.1:8000/v1",
				"N8N_VERSION_NOTIFICATIONS_ENDPOINT": "http://127.0.0.1:8000/api/versions/",
				"N8N_VERSION_NOTIFICATIONS_WHATS_NEW_ENDPOINT": "http://127.0.0.1:8000/api/whats-new",
				"N8N_DYNAMIC_BANNERS_ENDPOINT": "http://127.0.0.1:8000/api/banners",
				"N8N_RESTRICT_FILE_ACCESS_TO": "~/.n8n-files;${workspaceFolder}/vova/HANDOFF_EXPORT/04_production_engine"
			},
			"outputCapture": "std",
			"killBehavior": "polite"
		},
		{
			"name": "Igor Reels runner (Python)",
			"type": "debugpy",
			"request": "launch",
			"python": "${workspaceFolder}/vova/HANDOFF_EXPORT/.venv/Scripts/python.exe",
			"program": "${workspaceFolder}/vova/HANDOFF_EXPORT/03_skill_logic/igor_reels_n8n_runner.py",
			"args": ["serve", "--host", "127.0.0.1", "--port", "8787"],
			"cwd": "${workspaceFolder}",
			"env": {
				"IGOR_REELS_DOWNLOAD_COOKIES_FILE": "${workspaceFolder}/vova/HANDOFF_EXPORT/.secrets/instagram-cookies.txt"
			},
			"console": "integratedTerminal",
			"justMyCode": false
		},
